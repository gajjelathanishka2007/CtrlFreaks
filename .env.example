# Copy this file to `.env` and adjust the values for your machine.
#   copy .env.example .env
# `.env` is ignored by git (see .gitignore) so secrets never get committed.
# The app works without a .env file thanks to the defaults in app/config.py.

# Friendly name shown in the API docs (http://localhost:8000/docs)
APP_NAME="CtrlFreaks Backend"

# development | test | production
ENVIRONMENT=development

# SQLAlchemy connection string. This one creates ./ctrlfreaks.db in the project root.
DATABASE_URL=sqlite:///./ctrlfreaks.db

# Comma-separated list of frontend origins allowed by CORS.
# Add your teammate's port here if it differs.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OPTIONAL - AI services (Developer 4). The team has NOT agreed on a provider
# yet, so this is a documented placeholder only. It is read by the AI module
# (never by the backend) and is only needed in development.
# NEVER commit a real key: .env is gitignored, this file is not.
GEMINI_API_KEY=
