# ---- Frontend (Vite) environment ----
# Base URL of the Synq Node/Express API.
# The frontend NEVER connects to MongoDB directly — it always goes through the API.
VITE_API_BASE_URL=http://localhost:5000/api

# Data source strategy.
#  - "true"  (default): use the built-in mock service layer (no backend required).
#  - "false": call the real backend at VITE_API_BASE_URL, falling back to mock on failure.
VITE_USE_MOCK=true

# ---- Backend (Express) environment (server/.env) ----
# MONGODB_URI=mongodb://127.0.0.1:27017/synq
# PORT=5000
# CORS_ORIGIN=http://localhost:5173

# ---- AI service (server-side only) ----
# NEVER put API keys in VITE_* variables. Vite inlines VITE_* into the browser bundle.
# AI keys belong on the backend: OPENAI_API_KEY=...
