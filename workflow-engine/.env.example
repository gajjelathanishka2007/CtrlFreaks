# CtrlFreaks workflow engine — environment configuration
# Copy to .env and fill in only what you need. The engine runs fully offline
# without any of these values.

# SQLite database file (default: ./data/engine.db)
# CTRLFREAKS_DATABASE_URL=sqlite:///./data/engine.db

# Optional LLM used ONLY to write explanatory text for recommendations.
# The engine's validation, execution, diagnostics and retry logic NEVER
# depend on an LLM.
# CTRLFREAKS_LLM_ENABLED=false
# CTRLFREAKS_LLM_BASE_URL=https://api.openai.com/v1
# CTRLFREAKS_LLM_API_KEY=
# CTRLFREAKS_LLM_MODEL=gpt-4o-mini

# Safety cap: total attempts per step (retries are always bounded by this too).
# CTRLFREAKS_MAX_RETRY_ATTEMPTS=5

# Default timeout for the http_request step (seconds).
# CTRLFREAKS_HTTP_TIMEOUT=10